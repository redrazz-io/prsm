{
  "name": "@redrazz/prsm",
  "version": "1.0.0",
  "description": "Wire your AI stack once, deploy to any runtime.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redrazz-io/prsm.git"
  },
  "bin": {
    "prsm": "dist/cli.js"
  },
  "files": ["dist/cli.js"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun build src/cli.ts --compile --outfile dist/prsm",
    "build:bundle": "bun build src/cli.ts --outfile dist/cli.js --target node --banner '#!/usr/bin/env node'",
    "prepack": "bun run build:bundle",
    "test": "bun test",
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ci": "biome ci ."
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "semver": "^7.6.2",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/semver": "^7.5.8",
    "typescript": "^5.4.5"
  }
}
